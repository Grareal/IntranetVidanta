@inherits UmbracoViewPage
@using System.Globalization
@{
    Layout = "Shared/_Layout.cshtml";
    var ci = new CultureInfo("es-MX");
    var root = Model.Root();
    var plazas = root.Children().Where(c => c.ContentType.Alias == "plaza").ToList();
    var accesos = Model.Children().Where(c => c.ContentType.Alias == "accesoRapido").ToList();
    var apps = Model.Children().Where(c => c.ContentType.Alias == "aplicacion" && (c.Value("url") as string) != "#").ToList();
    var titulo = Model.Value("titulo") as string ?? "Bienvenido";
    var mensaje = Model.Value("mensaje") as string ?? "";
    var hoy = DateTime.Now;
}
<div class="home-landing">
    <div class="landing-hero">
        <div class="landing-content">
            <div class="landing-badge">Intranet Grupo Vidanta</div>
            <h1>@titulo</h1>
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <p class="landing-sub">@Html.Raw(mensaje)</p>
            }
            <p class="landing-date">@hoy.ToString("dddd, dd 'de' MMMM 'de' yyyy", ci)</p>
        </div>
    </div>
    <div class="landing-body">
        @if (plazas.Any())
        {
            <div class="section-header">
                <h2>Selecciona tu resort</h2>
                <p>Elige el resort para acceder a su información y recursos</p>
            </div>
            <div class="resort-grid">
                @foreach (var plaza in plazas)
                {
                    var imgUrl = plaza.Value<IPublishedContent>("imagen")?.Url() ?? "";
                    var desc = plaza.Value("descripcion") as string ?? "";
                    var ubicacion = plaza.Value("ubicacion") as string ?? "";
                    var color = plaza.Value("color") as string ?? "var(--emerald)";
                    <a class="resort-card" href="@plaza.Url()">
                        <div class="resort-card-img" style="@(imgUrl != "" ? $"background-image:url('{imgUrl}')" : $"background-color:{color}")">
                            @if (string.IsNullOrWhiteSpace(imgUrl))
                            {
                                <span class="resort-card-placeholder">@(plaza.Name.Substring(0, 1))</span>
                            }
                        </div>
                        <div class="resort-card-body">
                            <h3>@plaza.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(ubicacion)) { <span class="resort-card-location">@ubicacion</span> }
                            @if (!string.IsNullOrWhiteSpace(desc)) { <p>@desc</p> }
                            <span class="resort-card-action">Explorar resort →</span>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="no-resorts">
                <div class="empty-state">Aún no hay resorts configurados. Contacta al administrador.</div>
            </div>
        }
        @if (accesos.Any())
        {
            <div class="section-header" style="margin-top:40px">
                <h2>Accesos rápidos</h2>
            </div>
            <div class="quick-access glass-card">
                @foreach (var q in accesos)
                {
                    var qUrl = q.Value("url") as string ?? "#";
                    var qIcono = q.Value("icono") as string ?? "→";
                    var qNombre = q.Value("nombre") as string ?? q.Name;
                    <a class="qa-item" href="@(qUrl)" target="_blank" rel="noopener noreferrer">
                        <span class="qa-icon">@qIcono</span>@qNombre
                    </a>
                }
            </div>
        }
    </div>
</div>